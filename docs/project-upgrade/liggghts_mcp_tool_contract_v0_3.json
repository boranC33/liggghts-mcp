{
  "artifact": "liggghts_mcp_tool_contract_v0_3",
  "status": "design_ready",
  "source_project": "F:/PINN",
  "target_linux_server": "/home/neu/boran/liggghts-mcp/server.py",
  "tools": [
    {
      "name": "validate_project_environment",
      "purpose": "Validate PINN project paths, LIGGGHTS binary, scripts, environment, and DEM safety flags before project runs.",
      "required_inputs": ["pinn_root"],
      "optional_inputs": ["require_serial_liggghts", "run_parse_probe", "run_runtime_probe"],
      "required_outputs": ["pinn_root", "python_version", "liggghts_bin", "serial_liggghts", "missing_scripts", "gpu_used", "ready"]
    },
    {
      "name": "run_tilt_geometry_gates",
      "purpose": "Run one-particle tilted plate geometry/contact tests before broad tilted DEM batches.",
      "required_inputs": ["pinn_root", "tilts_deg"],
      "optional_inputs": ["workers", "overwrite"],
      "required_outputs": ["gate_rows", "passed_count", "failed_count", "failed_tilts", "ready_for_dem"]
    },
    {
      "name": "run_plate_manifest_batch",
      "purpose": "Generate and run LIGGGHTS plate cases from a project manifest with bounded CPU parallelism.",
      "required_inputs": ["pinn_root", "manifest_path", "batch_id", "workers"],
      "optional_inputs": ["require_geometry_gate", "raw_dump_policy", "overwrite", "resume"],
      "required_outputs": ["batch_id", "manifest_rows", "attempted_cases", "case_status_csv", "status_json", "mcp_used"]
    },
    {
      "name": "check_batch_status",
      "purpose": "Read persistent batch and case status after MCP restarts.",
      "required_inputs": ["batch_id"],
      "optional_inputs": ["tail"],
      "required_outputs": ["status", "exit_code", "completed_cases", "failed_cases", "running_cases", "last_log"]
    },
    {
      "name": "resume_plate_manifest_batch",
      "purpose": "Resume a manifest batch without rerunning completed cases.",
      "required_inputs": ["batch_id"],
      "optional_inputs": ["failed_only", "workers"],
      "required_outputs": ["resumed_cases", "skipped_completed_cases", "status"]
    },
    {
      "name": "postprocess_plate_batch",
      "purpose": "Run project postprocessing over a completed manifest batch.",
      "required_inputs": ["pinn_root", "batch_id"],
      "optional_inputs": ["bins", "include_tilted_smoke_postprocess"],
      "required_outputs": ["completed_stable_cases", "passed_cases", "liggghts_error_cases", "dangerous_build_cases", "force_csv_files", "contact_count_csv_files"]
    },
    {
      "name": "package_compact_return",
      "purpose": "Create one compact tarball and sha256 file for Windows without raw DEM dumps.",
      "required_inputs": ["pinn_root", "batch_id", "phase"],
      "optional_inputs": ["include_linux_done", "forbid_raw_dumps"],
      "required_outputs": ["tar_gz", "sha256", "raw_dumps_packaged", "forbidden_entries", "package_verified"]
    }
  ],
  "required_forbidden_raw_dumps": [
    "contact_local.dump",
    "particles.lammpstrj",
    "settlement_particles.lammpstrj",
    "settled_particles.lammpstrj"
  ],
  "required_safety_flags": {
    "gpu_used": false,
    "raw_dumps_packaged": false,
    "is_reference_quality": false,
    "is_training_data": false
  },
  "phase14B_profile": {
    "manifest_rows": 198,
    "geometry_gate_rows": 18,
    "recommended_workers": 48,
    "scope": "planar_tilt_pilot_not_full_universal_3d_closure"
  }
}
